{
  "name": "eu38-fitted-dress",
  "what": [
    "A fitted sleeveless dress: bodice with a waist dart and a bust dart each side,",
    "two waist darts each side at the back, a waistband, and a pencil skirt with",
    "four darts at the back. Eight pieces.",
    "",
    "There is no word for any of that below. Every point is a construction on a body",
    "measurement, every curve is a tangent angle and a length, and every seam that has",
    "to match is bound to the seam it matches by a formula rather than by both sides",
    "happening to come out the same. The names of the pieces are the only garment words",
    "in the file, and they are there because the referee reads them to decide what kind",
    "of seam it is looking at.",
    "",
    "STYLE against ANATOMY. Variables marked 'style' are decisions about this dress and",
    "nothing else. Everything not marked 'style' is arithmetic on the body."
  ],
  "variables": [
    {"name": "sh_tan", "formula": "tanD(shoulder_incl)",
     "why": "the shoulder falls at shoulder_incl degrees, so this is its slope"},
    {"name": "sh_cos", "formula": "cosD(shoulder_incl)",
     "why": "a step ALONG the shoulder line is a step across divided by this"},

    {"name": "arc_k_armhole",
     "formula": "(4/3)*tanD((90 + shoulder_incl)/4)/(2*sinD((90 + shoulder_incl)/2))",
     "why": "an armhole leaves the side seam square and the shoulder seam square, so its tangent turns by 90 degrees plus the shoulder slope. Two fixed ends and two fixed tangents over-determine a circle, so the edge is a cubic, and this is the control length that makes that cubic the circular arc of the same turn: (4/3)tan(t/4) of the radius, with the radius read off the chord. The fullness of the curve is therefore not a taste dial, it is the turn"},
    {"name": "arc_k_neck",
     "formula": "(4/3)*tanD((90 - shoulder_incl)/4)/(2*sinD((90 - shoulder_incl)/2))",
     "why": "same rule for a neckline: square to the fold at the centre, square to the shoulder seam at the neck point, so the tangent turns by 90 degrees minus the shoulder slope"},

    {"name": "front_w", "formula": "(bust - back_width)/2",
     "why": "half the front at the bust: what the back does not take"},
    {"name": "back_w", "formula": "back_width/2"},
    {"name": "front_waist", "formula": "(waist - waist_back_width)/2"},
    {"name": "back_waist", "formula": "waist_back_width/2"},

    {"name": "bust_lvl", "formula": "(2/3)*vert_bust_line + (1/3)*bust_line",
     "why": "the bust dart is balanced two thirds toward the vertical measure"},
    {"name": "bust_h", "formula": "waist_line - bust_lvl",
     "why": "height of the bust line above the waist"},

    {"name": "front_dart_w", "formula": "(front_w - front_waist)*2/3",
     "why": "two thirds of the front's waist reduction goes into the dart, one third to the side"},
    {"name": "front_dart_dep", "formula": "0.9*bust_h",
     "why": "the waist dart stops short of the bust point"},
    {"name": "side_dart_dep", "formula": "0.75*(front_w - bust_points/2)",
     "why": "the bust dart stops three quarters of the way in from the side"},

    {"name": "front_top", "formula": "waist_over_bust_line - sh_tan*(front_w - shoulder_w/2)",
     "why": "height of the shoulder line where it crosses the side of the front"},
    {"name": "fb_diff", "formula": "bust/2 - back_width",
     "why": "how much wider the front half is than a quarter of the bust"},
    {"name": "side_len", "formula": "waist_line - sh_tan*(back_w - shoulder_w/2) - sh_tan*fb_diff"},
    {"name": "side_dart_w", "formula": "front_top - side_len",
     "why": "the front is longer than the side needs to be; the difference is the bust dart"},
    {"name": "back_len", "formula": "waist_line - sh_tan*(back_w - shoulder_w/2)",
     "why": "height of the shoulder line where it crosses the side of the back"},

    {"name": "sleeve_balance", "formula": "1.0", "style": true,
     "why": "the shoulder seam stops 1cm inside the shoulder point, where a set-in sleeve wants its cap seam"},
    {"name": "sh_x", "formula": "shoulder_w/2 - sleeve_balance"},
    {"name": "blade_ease", "formula": "0.6", "style": true,
     "why": "the back shoulder is cut 6mm longer for the shoulder blade and eased onto the front; the field puts this at 6-12mm"},

    {"name": "neck_half", "formula": "neck_w/2 + 1.2", "style": true,
     "why": "the opening is cut 1.2cm wider than the base of the neck on each side"},
    {"name": "front_neck_drop", "formula": "1.2*neck_half", "style": true,
     "why": "the front neck drops a fifth more than its own half width"},
    {"name": "front_neck_y", "formula": "front_top + sh_tan*(front_w - neck_half) - front_neck_drop"},

    {"name": "underarm_clear", "formula": "1.0", "style": true,
     "why": "the armhole ends 1cm above the top of the bust dart; a sleeveless armhole is cut higher than one that takes a sleeve"},

    {"name": "back_cb_rise", "formula": "sh_tan*back_w/4",
     "why": "the centre back is drawn a little shorter than the side"},
    {"name": "back_dart_w", "formula": "5*(back_w - back_waist)/12",
     "why": "the two back darts take five sixths of the reduction between them, the side seam the other sixth"},
    {"name": "back_waist_run", "formula": "back_waist + 2*back_dart_w",
     "why": "the waist line has to be this long BEFORE the darts are folded out"},
    {"name": "b_side_x", "formula": "sqrt(back_waist_run**2 - back_cb_rise**2)",
     "why": "so the slanted waist line measures exactly back_waist_run; the side seam takes whatever is left"},
    {"name": "b_dart_in_c", "formula": "bum_points/2 - bum_points/8 + back_dart_w/2"},
    {"name": "b_dart_out_c", "formula": "bum_points/2 + bum_points/8 + 1.5*back_dart_w"},
    {"name": "b_dart_in_dep", "formula": "back_len - bust_lvl"},
    {"name": "b_dart_out_dep", "formula": "0.9*b_dart_in_dep"},
    {"name": "b_seg_cb", "formula": "b_dart_in_c - back_dart_w/2"},
    {"name": "b_seg_mid", "formula": "b_dart_out_c - back_dart_w - b_dart_in_c"},
    {"name": "b_seg_side", "formula": "back_waist_run - b_dart_out_c - back_dart_w/2"},

    {"name": "f_seg_cf", "formula": "bust_points/2"},
    {"name": "f_seg_side", "formula": "front_waist - bust_points/2"},

    {"name": "wb_w", "formula": "0.2*hips_line", "style": true,
     "why": "the waistband is a fifth of the waist-to-hip drop deep"},
    {"name": "wb_front_w", "formula": "2*front_waist"},
    {"name": "wb_back_w", "formula": "2*back_waist"},

    {"name": "leg_len", "formula": "height - head_l - waist_line - hips_line"},
    {"name": "skirt_len", "formula": "0.4*leg_len", "style": true,
     "why": "hem at two fifths of the leg below the hip line"},
    {"name": "skirt_waist_y", "formula": "skirt_len + hips_line"},
    {"name": "front_hip", "formula": "(hips - hip_back_width)/2"},
    {"name": "back_hip", "formula": "hip_back_width/2"},
    {"name": "hip_shift", "formula": "tanD(hip_inclination/2)*hips_line",
     "why": "how far the side seam leans in between hip and waist"},
    {"name": "side_take", "formula": "min(hip_shift, front_hip - front_waist)",
     "why": "the side seam takes the same amount off the front and the back, so the two side seams are the same seam"},
    {"name": "skirt_dart_w", "formula": "(back_hip - back_waist - side_take)/2",
     "why": "whatever the side does not take off the back, the two darts take"},
    {"name": "skirt_dart_in_dep", "formula": "0.85*hips_line"},
    {"name": "skirt_dart_out_dep", "formula": "0.9*skirt_dart_in_dep"},
    {"name": "sk_in_off", "formula": "bum_points/2 - bum_points/8 + skirt_dart_w/2"},
    {"name": "sk_out_off", "formula": "bum_points/2 + bum_points/8 + 1.5*skirt_dart_w"},
    {"name": "skirt_turn", "formula": "atanD(side_take/hips_line)",
     "why": "the side seam leaves the hip line square and leans in to the waist, so its tangent turns by this much"},
    {"name": "arc_k_skirt",
     "formula": "(4/3)*tanD(skirt_turn/4)/(2*sinD(skirt_turn/2))",
     "why": "the same circular-arc control length as the armhole and the neckline, for a much smaller turn"},
    {"name": "sk_l", "formula": "side_take", "why": "left end of the back skirt waist"},
    {"name": "sk_c", "formula": "back_hip", "why": "centre back of the back skirt"},

    {"name": "torso_top", "formula": "height - head_l",
     "why": "the block is hung from the base of the head"},
    {"name": "waist_level", "formula": "height - head_l - waist_line"}
  ],

  "points": [
    {"id": "f_cf_waist", "op": "origin", "x": "0", "y": "0"},
    {"id": "f_d1a", "op": "offset", "from": "f_cf_waist", "dx": "bust_points/2"},
    {"id": "f_d1b", "op": "offset", "from": "f_d1a", "dx": "front_dart_w"},
    {"id": "f_d1apex", "op": "swing", "a": "f_d1a", "b": "f_d1b",
     "r1": "front_dart_dep", "r2": "front_dart_dep", "side": "left"},
    {"id": "f_side_waist", "op": "offset", "from": "f_cf_waist", "dx": "front_waist + front_dart_w"},
    {"id": "f_bust_lo", "op": "offset", "from": "f_cf_waist", "dx": "front_w", "dy": "bust_h"},
    {"id": "f_bust_hi", "op": "offset", "from": "f_bust_lo", "dy": "side_dart_w"},
    {"id": "f_bustapex", "op": "swing", "a": "f_bust_lo", "b": "f_bust_hi",
     "r1": "side_dart_dep", "r2": "side_dart_dep", "side": "left"},
    {"id": "f_underarm", "op": "offset", "from": "f_bust_hi", "dy": "underarm_clear"},
    {"id": "f_sh_cf", "op": "offset", "from": "f_cf_waist", "dy": "front_top + sh_tan*front_w"},
    {"id": "f_sh_tip", "op": "polar", "from": "f_sh_cf", "angle": "-shoulder_incl", "length": "sh_x/sh_cos"},
    {"id": "f_sh_neck", "op": "polar", "from": "f_sh_cf", "angle": "-shoulder_incl", "length": "neck_half/sh_cos"},
    {"id": "f_cf_neck", "op": "origin", "x": "0", "y": "front_neck_y"},

    {"id": "b_side_waist", "op": "origin", "x": "b_side_x", "y": "0"},
    {"id": "b_cb_waist", "op": "origin", "x": "0", "y": "back_cb_rise"},
    {"id": "b_d_in_a", "op": "along", "a": "b_cb_waist", "b": "b_side_waist", "length": "b_dart_in_c - back_dart_w/2"},
    {"id": "b_d_in_b", "op": "along", "a": "b_cb_waist", "b": "b_side_waist", "length": "b_dart_in_c + back_dart_w/2"},
    {"id": "b_d_in_apex", "op": "swing", "a": "b_d_in_a", "b": "b_d_in_b",
     "r1": "b_dart_in_dep", "r2": "b_dart_in_dep", "side": "left"},
    {"id": "b_d_out_a", "op": "along", "a": "b_cb_waist", "b": "b_side_waist", "length": "b_dart_out_c - back_dart_w/2"},
    {"id": "b_d_out_b", "op": "along", "a": "b_cb_waist", "b": "b_side_waist", "length": "b_dart_out_c + back_dart_w/2"},
    {"id": "b_d_out_apex", "op": "swing", "a": "b_d_out_a", "b": "b_d_out_b",
     "r1": "b_dart_out_dep", "r2": "b_dart_out_dep", "side": "left"},
    {"id": "b_sh_cb", "op": "origin", "x": "0", "y": "back_len + sh_tan*back_w"},
    {"id": "b_sh_tip", "op": "polar", "from": "b_sh_cb", "angle": "-shoulder_incl",
     "length": "sh_x/sh_cos + blade_ease",
     "why": "the back shoulder is the front shoulder plus the blade ease, by construction"},
    {"id": "b_sh_neck", "op": "polar", "from": "b_sh_cb", "angle": "-shoulder_incl", "length": "neck_half/sh_cos"},
    {"id": "b_cb_neck", "op": "origin", "x": "0", "y": "back_len"},
    {"id": "b_side_mid", "op": "polar", "from": "b_side_waist",
     "angle": "acosD((back_w - b_side_x)/(Line_f_side_waist_f_bust_lo + Line_f_bust_hi_f_underarm))",
     "length": "Line_f_side_waist_f_bust_lo",
     "why": "the back side seam is the front side seam, measured off the front and laid down from the back waist"},
    {"id": "b_underarm", "op": "polar", "from": "b_side_waist",
     "angle": "acosD((back_w - b_side_x)/(Line_f_side_waist_f_bust_lo + Line_f_bust_hi_f_underarm))",
     "length": "Line_f_side_waist_f_bust_lo + Line_f_bust_hi_f_underarm"},

    {"id": "wbf_0", "op": "origin", "x": "0", "y": "0"},
    {"id": "wbf_1", "op": "origin", "x": "wb_front_w", "y": "0"},
