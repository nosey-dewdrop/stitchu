    {"id": "wbf_4", "op": "origin", "x": "wb_front_w - f_seg_side - f_seg_cf", "y": "wb_w"},
    {"id": "wbf_5", "op": "origin", "x": "f_seg_side", "y": "wb_w"},
    {"id": "wbf_6", "op": "origin", "x": "0", "y": "wb_w"},

    {"id": "wbb_0", "op": "origin", "x": "0", "y": "0"},
