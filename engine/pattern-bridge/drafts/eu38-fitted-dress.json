    {"id": "sb_i2a", "op": "origin", "x": "sk_c + sk_in_off - skirt_dart_w/2", "y": "skirt_waist_y"},
    {"id": "sb_i2b", "op": "origin", "x": "sk_c + sk_in_off + skirt_dart_w/2", "y": "skirt_waist_y"},
    {"id": "sb_i2p", "op": "swing", "a": "sb_i2a", "b": "sb_i2b",
