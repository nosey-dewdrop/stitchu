        },
        {
          "id": "hollow",
          "f": "hollowShareBack * dx"
        },
        {
          "id": "chord",
          "f": "hypot(dx, dy)"
        },
        {
          "id": "stxRaw",
          "f": "tipX - backNeckW"
        },
        {
          "id": "slen",
          "f": "hypot(stxRaw, bTipDrop)"
        },
        {
          "id": "stx",
