          "f": "tipX + stx * tanReach"
        },
        {
          "id": "cp1y",
          "f": "bTipDrop + sty * tanReach"
        },
        {
          "id": "cp2x",
          "f": "backWidth - dx * 0.06 - hollow"
        },
        {
          "id": "cp2y",
          "f": "bTipDrop + dy * lowerDropShare"
        },
        {
          "id": "grainX",
          "f": "max(cbTakeIn, 20) + 20"
        }
      ],
      "points": [
        {
          "id": "centerNeck",
          "x": "0",
          "y": "backCutout"
        },
        {
          "id": "neckPoint",
          "x": "backNeckW",
          "y": "0"
        },
        {
          "id": "shoulderTip",
          "x": "tipX",
          "y": "bTipDrop"
        },
        {
          "id": "underarm",
          "x": "backWidth",
          "y": "underarmY"
        },
        {
          "id": "hemSide",
          "x": "hipHalfQuarter",
          "y": "backLengthMM + extendMM - 10"
        },
        {
          "id": "hemCenter",
          "x": "0",
          "y": "backLengthMM + extendMM"
        }
      ],
      "outline": [
        {
          "op": "move",
