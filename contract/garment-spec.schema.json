            "crew",
            "scoop",
            "vNeck",
            "square",
            "boat",
            "sweetheart",
            "halter",
            "cowl",
            "pussyBow",
            null
          ]
        },
        "sleeveStyle": {
          "enum": [
            "none",
            "straight",
            "balloon",
            null
          ]
        },
        "sleeveLength": {
          "enum": [
            "short",
            "elbow",
            "long",
            null
          ]
        },
        "skirtStyle": {
          "enum": [
            "aLine",
            "straight",
            "gathered",
            "halfCircle",
            "pleated",
            "gore",
            null
          ]
        },
        "length": {
          "enum": [
            "mini",
            "midi",
            "maxi",
            null
          ]
        },
        "topLength": {
          "enum": [
            "cropped",
            "hip",
            "tunic",
            null
          ]
        },
        "shaping": {
          "enum": [
            "princess",
            "dart",
            null
          ]
        },
        "waistline": {
          "enum": [
            "natural",
            "empire",
            null
          ]
        },
        "fabric": {
          "enum": [
            "woven",
            "knit",
            null
          ]
        },
        "hemRuffle": {
          "enum": [
            "none",
            "single",
            "tiered",
            null
          ]
        },
        "keyhole": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fabricName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "closure": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "buttons",
                "placket",
                "zipper",
                "ties",
                "lace-up",
                "hookEye",
                "none",
                null
              ]
            },
            "location": {
              "enum": [
                "centerFront",
                "centerBack",
                "sideSeam",
                "shoulder",
                "neck",
                "waist",
                null
              ]
            }
          }
        },
        "collar": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "none",
                "stand",
                "shirt",
                "peterPan",
                "mandarin",
                "notched",
                "sailor",
                "other",
                null
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 80
            }
          }
        },
        "straps": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "none",
                "shoulder",
                "spaghetti",
                "wide",
                "halter",
                "ruffled",
                "oneShoulder",
                "offShoulder",
                null
              ]
            },
            "count": {
              "enum": [
                1,
                2,
                null
              ]
            }
          }
        },
        "cupSeams": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sleeveHead": {
          "enum": [
            "plain",
            "gathered",
            "puffed",
            "capped",
            null
          ]
        },
        "yoke": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "none",
                "shoulderYoke",
                "shirring",
                "smocking",
                null
              ]
            },
            "location": {
              "enum": [
                "frontBodice",
                "backBodice",
                "shoulder",
                "waist",
                null
              ]
            }
          }
        },
        "backDetail": {
          "enum": [
            "none",
            "openBack",
            "keyholeBack",
            "vBack",
            "tieBack",
            "lacedBack",
            "buttonBack",
            null
          ]
        },
        "outOfVocab": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 24
        },
        "details": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 400
        }
      }
    },
    "draftSpec": {
      "description": "The engine spec: what the pattern engine drafts from. String enums come 1:1 from engine/vocab.json (single vocabulary source; index = C++ enum value). Body measurements are bounded real centimetres.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "garment": {
          "enum": [
            "skirt",
            "dress",
            "top"
          ]
        },
        "shaping": {
          "enum": [
            "princess",
            "dart"
