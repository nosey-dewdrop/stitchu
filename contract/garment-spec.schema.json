        },
        "armholeHollow": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.4,
          "description": "STYLE parameter (Damla 2026-07-19): armhole scoop fraction of the flat silhouette. No effect on pattern geometry. Was review.* (layer undecided); decided as flat.* style."
        },
        "goreCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12,
