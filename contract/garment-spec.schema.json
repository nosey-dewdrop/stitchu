{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosey-dewdrop.github.io/stitchu/contract/garment-spec.schema.json",
  "title": "stitchu garment spec contract",
  "description": "K1 single contract (2026-07-19), version 1.0.0. TWO layers. SEMANTIC layer = garment language: closed enums + bounded scalars; the only language the VLM and a human speak (vision reading + draft spec). RENDER layer is NOT in this contract: every renderer compiles its own slider/parameters from the semantics (flat.* below is the flat renderer's declared recipe namespace, for validation of stored recipes only). An LLM/VLM can never write render parameters: the visionReading schema has additionalProperties:false, so any armholeHollow/capPuff/seed smuggled into a vision answer is rejected. Enum values are cross-checked against engine/vocab.json by engine/tools/validate-contract.mjs (the ratchet); a drift fails the test suite.",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "garment-spec/1"
    },
    "vision": {
      "$ref": "#/$defs/visionReading"
    },
    "draft": {
      "$ref": "#/$defs/draftSpec"
    },
    "flat": {
      "$ref": "#/$defs/flatRecipe"
    },
    "review": {
      "$ref": "#/$defs/reviewParams"
    }
  },
  "$defs": {
    "visionReading": {
      "description": "What the vision layer is allowed to say about a photo. SEMANTIC ONLY. Unknown fields are rejected (additionalProperties:false); a value outside its enum is invalid. The bridge (web/js/vision-bridge.js) compiles this into draftSpec; the declared cross-layer translations live in contract/tables.json mappings.*.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "garment": {
          "enum": [
            "skirt",
            "dress",
            "top",
            "trousers",
            "other"
          ]
        },
        "neckline": {
