            "knee",
            "midi"
          ]
        },
        "ink": {
          "enum": [
            "minimal",
            "orta",
            "full"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "bustProject": {
          "type": "number",
